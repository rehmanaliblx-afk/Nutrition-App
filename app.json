{
  "expo": {
    "name": "FitTrack",
    "slug": "fittrack",
    "owner": "rehmanali5018",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a3c"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.rehmanali5018.nutritionapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a3c"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        { "cameraPermission": "Allow FitTrack to access your camera to scan food barcodes." }
      ],
      "expo-document-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "5c013c5c-28d1-44d7-84ac-d564ab6f6787"
      }
    }
  }
}
